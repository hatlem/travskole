# Database (PostgreSQL — Azure: leveres av Orange via Key Vault)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NextAuth (kritisk i prod — uten disse feiler innlogging)
NEXTAUTH_URL=https://registrering.bjerke.no
NEXTAUTH_SECRET= # generer med: openssl rand -base64 32

# SMTP (Azure Communication Services)
SMTP_HOST=smtp.azurecomm.net
SMTP_PORT=587
SMTP_FROM=noreply@registrering.bjerke.no
SMTP_USER=registrering
SMTP_PASS=

# Cron — delt hemmelighet mellom Azure Function og web-appens cron-ruter
# (/api/cron/email-triggers OG /api/cron/flows — samme hemmelighet, samme
# Bearer-header, gjenbrukt av flyt-motorens timer). Ingen ny web-app-variabel
# for flyt-motoren: dens timer-URL (CRON_TARGET_URL_FLOWS) er kun konfigurert
# på Azure Function-appen selv (Function App → Configuration), ikke her.
CRON_SECRET= # generer med: openssl rand -hex 32

# Opplastede kursbilder — MÅ peke utenfor wwwroot på Azure (zipdeploy visker wwwroot)
# Lokalt: la stå tom (faller tilbake til public/images)
UPLOAD_DIR=/home/data/uploads

# Seeding (kun førstegangsoppsett)
SEED_SECRET= # generer med: openssl rand -hex 32
SEED_ADMIN_PASSWORD= # valgfritt — genereres tilfeldig hvis tom

# Magic link-innlogging (valgfritt — credentials-innlogging virker uten)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# GetPlatform feedback-widget (valgfritt)
GETPLATFORM_URL=
GETPLATFORM_API_KEY=

# getcookies samtykke-widget — domain-id fra https://app.getcookies.co dashboard
# (Domains → velg domene → Installation). Tom = widget lastes ikke, ingen sporing.
NEXT_PUBLIC_GETCOOKIES_DOMAIN_ID=

# Stripe (betaling) — live-nøkler. Publiserbar nøkkel er hardkodet i koden,
# ikke en miljøvariabel. Krav for at Stripe-betaling skal virke i prod.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET= # fra Stripe dashboard → Developers → Webhooks

# Stripe (betaling) — testmodus-nøkler, brukes når kurset har test-modus skrudd på
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=

# Vipps/MobilePay (betaling) — live-nøkler fra Vipps portal (portal.vippsmobilepay.com)
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_SUBSCRIPTION_KEY_SECONDARY= # dokumentert, reserve, ubrukt i koden
VIPPS_MSN= # Merchant Serial Number — identifiserer avtalen din hos Vipps
VIPPS_WEBHOOK_SECRET= # for verifisering av innkommende webhook-kall fra Vipps

# Vipps/MobilePay (betaling) — testmodus-nøkler, brukes når kurset har test-modus skrudd på
VIPPS_CLIENT_ID_TEST=
VIPPS_CLIENT_SECRET_TEST=
VIPPS_SUBSCRIPTION_KEY_TEST=
VIPPS_SUBSCRIPTION_KEY_SECONDARY_TEST= # dokumentert, reserve, ubrukt i koden
VIPPS_MSN_TEST=

# Microsoft Graph (svar-stopp / bounce-håndtering i e-postflyter) — Entra
# app-registrering med application permission Mail.Read, scopet via
# ApplicationAccessPolicy til avsenderpostboksene (se
# docs/bestilling-graph-tilgang.md). Hele svar/bounce-pollingen er
# konfigurasjonsstyrt — tom/manglende = ingen polling, ingen feil.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOXES= # kommaseparert: registrering@bjerke.no,hilde.apneseth@bjerke.no,andre.ringelien@bjerke.no,hege.karin.arverud@bjerke.no,stine.rasmussen@bjerke.no,bjerke@bjerke.no,arild.engebretsen@bjerke.no

# KI-lag (valgfritt) — redigeringsassistent, sekvens-generering, personalisering
# og engasjementsanalyse. Udefinert = alt KI er helt av (ingen feil, ingen UI).
# AI_PROVIDER: anthropic (standard) | openai
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL= # standard: claude-sonnet-5
OPENAI_API_KEY=
OPENAI_BASE_URL= # standard: https://api.openai.com/v1 — settes for OpenAI-kompatible verter
OPENAI_MODEL= # standard: gpt-4o-mini
