# Database (PostgreSQL — Azure: leveres av Orange via Key Vault)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NextAuth (kritisk i prod — uten disse feiler innlogging)
NEXTAUTH_URL=https://registrering.bjerke.no
NEXTAUTH_SECRET= # generer med: openssl rand -base64 32

# SMTP (Azure Communication Services)
SMTP_HOST=smtp.azurecomm.net
SMTP_PORT=587
SMTP_FROM=noreply@registrering.bjerke.no
SMTP_USER=registrering
SMTP_PASS=

# Cron — delt hemmelighet mellom Azure Function og /api/cron/email-triggers
CRON_SECRET= # generer med: openssl rand -hex 32

# Opplastede kursbilder — MÅ peke utenfor wwwroot på Azure (zipdeploy visker wwwroot)
# Lokalt: la stå tom (faller tilbake til public/images)
UPLOAD_DIR=/home/data/uploads

# Seeding (kun førstegangsoppsett)
SEED_SECRET= # generer med: openssl rand -hex 32
SEED_ADMIN_PASSWORD= # valgfritt — genereres tilfeldig hvis tom

# Magic link-innlogging (valgfritt — credentials-innlogging virker uten)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# GetPlatform feedback-widget (valgfritt)
GETPLATFORM_URL=
GETPLATFORM_API_KEY=
