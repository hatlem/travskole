// Prisma schema for Bjerke Ponniskole
// Development: SQLite | Production: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth required models
model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// User model - Authentication & Role-based access
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?  @map("password_hash")
  role          String   @default("parent") // 'parent', 'admin', or 'superadmin'
  createdAt     DateTime @default(now()) @map("created_at")

  parent   Parent?
  accounts Account[]
  sessions Session[]

  @@map("users")
}

// Parent model - Foreldre (linked to User)
model Parent {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  name      String
  phone     String
  address   String?
  deletedAt DateTime? @map("deleted_at") // GDPR soft delete
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  children      Child[]
  registrations Registration[]
  
  @@map("parents")
}

// Child model - Barn (linked to Parent)
model Child {
  id        Int       @id @default(autoincrement())
  parentId  Int       @map("parent_id")
  name      String
  birthdate DateTime?
  allergies String?
  deletedAt DateTime? @map("deleted_at") // GDPR soft delete
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  
  parent        Parent         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  registrations Registration[]
  
  @@map("children")
}

// Course model - Kurs & Leirer
model Course {
  id              Int       @id @default(autoincrement())
  name            String
  slug            String?
  description     String?
  type            String    // 'kurs' or 'leir'
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  ageMin          Int?      @map("age_min")
  ageMax          Int?      @map("age_max")
  price           Float?
  maxParticipants Int?      @map("max_participants")
  status          String    @default("open") // 'open', 'full', 'closed'
  imageUrl        String?   @map("image_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  registrations Registration[]
  emailTriggers EmailTrigger[]

  @@unique([type, slug])
  @@map("courses")
}

// Site settings (key-value store)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// Dobbeltsulky booking requests
model BookingRequest {
  id            Int      @id @default(autoincrement())
  name          String
  email         String
  phone         String
  participants  Int      @default(1)
  preferredDate DateTime? @map("preferred_date")
  message       String?
  status        String   @default("new") // 'new', 'confirmed', 'cancelled'
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("booking_requests")
}

// Activity log - Admin handlinger
model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String   // 'create', 'update', 'delete', 'email', 'status_change'
  entity    String   // 'course', 'registration', 'user', 'booking'
  entityId  Int?     @map("entity_id")
  details   String?  // JSON string with extra info
  userEmail String   @map("user_email")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

// Registration model - Påmeldinger (links Course, Child, Parent)
model Registration {
  id                 Int      @id @default(autoincrement())
  courseId           Int      @map("course_id")
  childId            Int      @map("child_id")
  parentId           Int      @map("parent_id")
  consentActivities  Boolean  @default(false) @map("consent_activities")
  consentMedia       Boolean  @default(false) @map("consent_media")
  consentRisk        Boolean  @default(false) @map("consent_risk")
  status             String   @default("pending") // 'pending', 'confirmed', 'cancelled'
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  child     Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent    Parent     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  emailLogs EmailLog[]

  @@map("registrations")
}

// Email template system
model EmailTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  triggers EmailTrigger[]

  @@map("email_templates")
}

model EmailTrigger {
  id          Int      @id @default(autoincrement())
  courseId    Int      @map("course_id")
  templateId Int?     @map("template_id")
  triggerType String  @map("trigger_type")
  offsetDays Int      @default(0) @map("offset_days")
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logs     EmailLog[]

  @@map("email_triggers")
}

model EmailLog {
  id             Int      @id @default(autoincrement())
  triggerId      Int      @map("trigger_id")
  registrationId Int      @map("registration_id")
  recipientEmail String   @map("recipient_email")
  status         String   @default("sent")
  sentAt         DateTime @default(now()) @map("sent_at")

  trigger      EmailTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([triggerId, registrationId])
  @@map("email_logs")
}
